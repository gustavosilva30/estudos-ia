# Valores ILUSTRATIVOS. Copie para .env e troque; nunca versione o .env real.
APP_ENV=development                # development | production | test

# PostgreSQL (próprio, sem Supabase)
POSTGRES_USER=estudos
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=estudos
DATABASE_URL=postgresql+psycopg://estudos:troque-esta-senha@127.0.0.1:5432/estudos

# Segurança
SECRET_KEY=troque-por-um-valor-aleatorio-longo
ALLOWED_ORIGINS=http://localhost:3000
MAX_BODY_BYTES=1000000
FRONTEND_URL=http://localhost:3000

# Autenticação
REGISTRATION_ENABLED=true          # false desliga o cadastro de novos usuários
SESSION_TTL_HOURS=168              # expira após 7 dias sem uso
SESSION_ABSOLUTE_DAYS=30           # teto máximo desde o login
PASSWORD_RESET_TTL_MINUTES=30
RATE_LIMIT_LOGIN_PAIR=5            # tentativas / 15 min por e-mail + IP
RATE_LIMIT_LOGIN_EMAIL=20
RATE_LIMIT_LOGIN_IP=30
RATE_LIMIT_REGISTER_IP=10
RATE_LIMIT_RESET_IP=10

# E-mail (ainda não implementado: sem SMTP, o link de recuperação aparece no log em desenvolvimento)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Frontend
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# IA — provedores: "fake" (teste, sem custo) ou "gemini" (Google). Nunca versione a chave real.
AI_PROVIDER=fake
AI_MODEL=fake-1                    # gemini: gemini-3.5-flash-lite (barato) ou gemini-3.8-flash
# AI_API_KEY=                      # gemini: chave do Google AI Studio (só no painel do servidor)
# AI_THINKING_LEVEL=               # gemini: minimal | low | medium | high (vazio = padrão do modelo)
AI_TIMEOUT_SECONDS=60
AI_MAX_INPUT_CHARS=60000           # tamanho máximo do texto enviado à IA
AI_MAX_OUTPUT_TOKENS=2000           # gemini: o raciocínio conta aqui; use ~4000
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=0.5
AI_RATE_LIMIT_PER_MINUTE=6         # por usuário
AI_MONTHLY_BUDGET_USD=10           # 0 = sem limite
AI_PRICE_INPUT_PER_MTOK=0          # USD por milhão de tokens; preencha conforme o modelo
AI_PRICE_OUTPUT_PER_MTOK=0
